{
  "id": "vei.app.sub",
  "name": "GnA1J 应用订阅",
  "author": "@GnA1J",
  "icon": "https://github.com/LAD0516/Scripts/raw/main/QuanX/images/JC.png",
  "repo": "https://github.com/LAD0516/Scripts/raw/main/QuanX",
  "apps": [
    {
      "id": "glados",
      "name": "GlaDos",
      "keys": [
        "gladosNotify",
        "gladosDebug",
        "gladosDiagnostics",
        "gladosMinDelay",
        "gladosMaxDelay",
        "gladosMaxRetries",
        "gladosCookie"
      ],
      "settings": [
        {
          "id": "gladosNotify",
          "name": "开启通知",
          "val": true,
          "type": "boolean",
          "desc": "是否开启签到结果通知（默认：开启）"
        },
        {
          "id": "gladosDebug",
          "name": "Debug 调试模式",
          "val": false,
          "type": "boolean",
          "desc": "是否开启 Debug 调试日志（默认：关闭）"
        },
        {
          "id": "gladosDiagnostics",
          "name": "诊断信息",
          "val": true,
          "type": "boolean",
          "desc": "是否开启诊断日志输出（默认：开启）"
        },
        {
          "id": "gladosMinDelay",
          "name": "最小延时 (秒)",
          "val": "3",
          "type": "number",
          "placeholder": "3",
          "desc": "随机延时排队签到的最小秒数"
        },
        {
          "id": "gladosMaxDelay",
          "name": "最大延时 (秒)",
          "val": "10",
          "type": "number",
          "placeholder": "10",
          "desc": "随机延时排队签到的最大秒数"
        },
        {
          "id": "gladosMaxRetries",
          "name": "失败重试次数",
          "val": "3",
          "type": "number",
          "placeholder": "3",
          "desc": "接口请求失败或返回为空时的最大重试次数（默认 3 次）"
        },
        {
          "id": "gladosCookie",
          "name": "Cookie",
          "val": "",
          "type": "textarea",
          "placeholder": "xxxxxxxxx@xxxxxxxx",
          "desc": "抓包搜索 user 把请求头的Cookie填到glados_ck中,多账号用@隔开"
        }
      ],
      "author": "@GnA1J",
      "repo": "https://github.com/LAD0516/Scripts/tree/main/QuanX/Task",
      "icons": ["https://glados.rocks/favicon.ico", "https://glados.rocks/favicon.ico"],
      "script": "https://raw.githubusercontent.com/LAD0516/Scripts/main/QuanX/Task/glados.js"
    },
    {
      "id": "xxcd",
      "name": "星星充电",
      "keys": [
        "XXCDNotify",
        "XXCDDebug",
        "XXCDDiagnostics",
        "XXCDMinDelay",
        "XXCDMaxDelay",
        "XXCDMaxRetries",
        "XXCDCookie"
      ],
      "settings": [
        {
          "id": "XXCDNotify",
          "name": "开启通知",
          "val": true,
          "type": "boolean",
          "desc": "是否开启签到结果通知（默认：开启）"
        },
        {
          "id": "XXCDDebug",
          "name": "Debug 调试模式",
          "val": false,
          "type": "boolean",
          "desc": "是否开启 Debug 调试日志（默认：关闭）"
        },
        {
          "id": "XXCDDiagnostics",
          "name": "诊断信息",
          "val": true,
          "type": "boolean",
          "desc": "是否开启诊断日志输出（默认：开启）"
        },
        {
          "id": "XXCDMinDelay",
          "name": "最小延时 (秒)",
          "val": "3",
          "type": "number",
          "placeholder": "3",
          "desc": "随机延时排队签到的最小秒数（默认 3 秒）"
        },
        {
          "id": "XXCDMaxDelay",
          "name": "最大延时 (秒)",
          "val": "8",
          "type": "number",
          "placeholder": "8",
          "desc": "随机延时排队签到的最大秒数（默认 8 秒）"
        },
        {
          "id": "XXCDMaxRetries",
          "name": "失败重试次数",
          "val": "3",
          "type": "number",
          "placeholder": "3",
          "desc": "接口请求失败或返回为空时的最大重试次数（默认 3 次）"
        },
        {
          "id": "XXCDCookie",
          "name": "XXCDCookie",
          "val": "",
          "type": "textarea",
          "placeholder": "X-Ca-Signature&X-Ca-Timestamp&x-uid&userId&Authorization&User-Agent&body",
          "desc": "简易格式：X-Ca-Signature&X-Ca-Timestamp&x-uid&userId&Authorization&User-Agent&body（多账号用@隔开）。也支持完整JSON格式。"
        }
      ],
      "author": "@GnA1J",
      "repo": "https://github.com/LAD0516/Scripts/tree/main/Task",
      "icons": [
        "https://webcdn.starcharge.com/resources/logo/2606/favicon.ico",
        "https://webcdn.starcharge.com/resources/logo/2606/favicon.ico"
      ],
      "script": "https://raw.githubusercontent.com/LAD0516/Scripts/main/Task/XXCD.js"
    }
  ]
}
